<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.freepark.cloud</groupId>
        <artifactId>freepark-cloud-simple-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>freepark-cloud-simple-parking</artifactId>
    <name>freepark-cloud-simple-parking</name>
    <description>车场业务模块：车场管理（停车场/车位/岗亭/通道/内部车辆）、通行管理（白名单/黑名单/放行规则/通行判定）、停车流水</description>

    <dependencies>
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 依赖用户模块：复用账号状态校验（业务写操作仅启用状态管理员可执行） -->
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 依赖计费模块：停车流水按车场计费绑定结算应收金额（新增/出入场更新/重新算费时快照） -->
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-billing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 依赖系统配置模块：实现其边缘运行时 SPI（EdgeSyncTargetSource / EdgeConfigSnapshotBuilder），
             向云端配置同步与车场心跳监控提供“车场”维度的目标与数据 -->
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-settings</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Excel 导入/导出（内部车辆/白名单/黑名单/泊位） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>
    </dependencies>
</project>
