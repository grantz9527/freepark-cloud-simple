<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.freepark.cloud</groupId>
    <artifactId>freepark-cloud-simple-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>freepark-cloud-simple-backend</name>
    <description>FreePark 云停车后端工程（仅作为聚合/POM 目录，按功能拆分子模块）</description>

    <modules>
        <!-- 依赖启动模块：负责装配各功能模块并作为应用启动入口 -->
        <module>freepark-cloud-simple-startup</module>
        <!-- 通用基础模块：统一返回结构、认证/权限等 -->
        <module>freepark-cloud-simple-common</module>
        <!-- 用户功能模块：账号/登录/权限 -->
        <module>freepark-cloud-simple-user</module>
        <!-- 车场业务模块：车场管理/通行管理/停车流水（参考 freepark local_server 子集） -->
        <module>freepark-cloud-simple-parking</module>
        <!-- 计费模块：计费日期管理/计费规则 -->
        <module>freepark-cloud-simple-billing</module>
        <!-- 系统配置模块：区域与语言 / 车牌颜色 -->
        <module>freepark-cloud-simple-settings</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
