<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.freepark.cloud</groupId>
    <artifactId>freepark-cloud-simple-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>freepark-cloud-simple-backend</name>
    <description>FreePark 云停车后端工程（仅作为聚合/POM 目录，按功能拆分子模块）</description>

    <modules>
        <!-- 依赖启动模块：负责装配各功能模块并作为应用启动入口 -->
        <module>freepark-cloud-simple-startup</module>
        <!-- 后续新增功能模块在此追加，例如 freepark-cloud-simple-user、freepark-cloud-simple-parking -->
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 各业务子模块统一在此登记版本，便于 startup 引用 -->
        </dependencies>
    </dependencyManagement>
</project>
