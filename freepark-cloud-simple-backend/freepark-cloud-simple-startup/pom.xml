<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.freepark.cloud</groupId>
        <artifactId>freepark-cloud-simple-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>freepark-cloud-simple-startup</artifactId>
    <name>freepark-cloud-simple-startup</name>
    <description>依赖启动模块：声明各功能模块依赖并提供应用启动入口</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 用户功能模块 -->
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-user</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 车场业务模块：车场管理 / 通行管理 / 停车流水 -->
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-parking</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 计费模块：计费日期管理 / 计费规则 -->
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-billing</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 系统配置模块：区域与语言 / 车牌颜色 -->
        <dependency>
            <groupId>com.freepark.cloud</groupId>
            <artifactId>freepark-cloud-simple-settings</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
