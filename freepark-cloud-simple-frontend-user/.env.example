# VITE_APP_ENV=development|test|production
# VITE_BASE=/ 或 /freepark-user/
# VITE_API_BASE_URL=/api
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

VITE_APP_ENV=development
VITE_BASE=/
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
